<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Syncfusion.EJ2.Spreadsheet.AspNet.Core" Version="35.1.37" />
    <!-- DocumentEditor + DocIO + DocIORenderer for the Python wrapper. -->
    <PackageReference Include="Syncfusion.EJ2.WordEditor.AspNet.Core" Version="35.1.37" />
    <PackageReference Include="Syncfusion.DocIO.Net.Core" Version="35.1.37" />
    <PackageReference Include="Syncfusion.DocIORenderer.Net.Core" Version="35.1.37" />
  </ItemGroup>

  <!--
    Force the publish output to include a runtimeconfig.json so the
    .NET host (and pythonnet's coreclr runtime) knows this DLL is
    net8.0 and not a netstandard facade. Without this, pythonnet tries
    to resolve System.IO.Stream against System.Runtime v4.0.0.0 and
    fails with TypeLoadException on every type that has Stream in its
    signature (e.g. SpreadsheetEditor.Save).
  -->
  <ItemGroup>
    <None Include="WebServiceLibrary.runtimeconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
